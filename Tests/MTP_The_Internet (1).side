  "name": "MTP_The_Internet",
  "url": "https://the-internet.herokuapp.com",
  "tests": [
    {
      "id": "t1",
      "name": "TC-01_Login_valido",
      "commands": [
        {
          "id": "c1",
          "comment": "",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c2",
          "comment": "",
          "command": "type",
          "target": "id=username",
          "targets": [
            [
              "id=username",
              "id"
            ],
            [
              "name=username",
              "name"
            ],
            [
              "css=#username",
              "css:finder"
            ]
          ],
          "value": "tomsmith"
        },
        {
          "id": "c3",
          "comment": "",
          "command": "type",
          "target": "id=password",
          "targets": [
            [
              "id=password",
              "id"
            ],
            [
              "name=password",
              "name"
            ],
            [
              "css=#password",
              "css:finder"
            ]
          ],
          "value": "SuperSecretPassword!"
        },
        {
          "id": "c4",
          "comment": "",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [
            [
              "css=button.radius",
              "css:finder"
            ],
            [
              "xpath=//button[@type='submit']",
              "xpath:attributes"
            ]
          ],
          "value": ""
        },
        {
          "id": "c4b",
          "comment": "",
          "command": "pause",
          "target": "1500",
          "targets": [],
          "value": ""
        },
        {
          "id": "c5",
          "comment": "",
          "command": "assertText",
          "target": "id=flash-messages",
          "targets": [
            [
              "id=flash-messages",
              "id"
            ],
            [
              "css=#flash-messages",
              "css:finder"
            ]
          ],
          "value": "You logged into a secure area! ×"
        }
      ]
    },
